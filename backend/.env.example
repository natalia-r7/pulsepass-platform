# Plantilla de variables de entorno, SIN secretos (PRD Seguridad §14.2, P4-03-i).
# Copiar como .env (ignorado por Git) y completar los valores.
# Spring Boot no lee .env automáticamente: exporta las variables antes de arrancar la aplicación.

# Clave HMAC del JWT en Base64 estándar, de al menos 32 bytes. Generar una con:
#   openssl rand -base64 32
PULSEPASS_JWT_SECRET_BASE64=

# Emisor del JWT (claim iss). Opcional: por defecto, pulsepass-api.
PULSEPASS_JWT_ISSUER=pulsepass-api
